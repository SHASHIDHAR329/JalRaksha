# ============================================================
# JalRaksha Git Ignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Generated model / simulation outputs
outputs/

# SAR imagery / large geospatial rasters
inputs/sar/*.tif
inputs/sar/*.tiff
inputs/sar/*.jp2
inputs/sar/*.zip

# Large generated simulation files inside simulations
simulations/**/output/
simulations/**/outputs/
simulations/**/data/
simulations/**/*.bi4
simulations/**/*.vtk
simulations/**/*.vtu
simulations/**/*.pvtu
simulations/**/*.out
simulations/**/*.log
simulations/**/*.rst
simulations/**/*.his
simulations/**/*.map
simulations/**/*.dia

# Generated NetCDF/results
simulations/**/*.nc

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# OS files
Thumbs.db
.DS_Store

# Editor/local files
.vscode/*.log

# Local backup archives
*.zip
*.7z
*.rar

# ============================================================
# JalRaksha integration workspace generated/heavy artifacts
# ============================================================

# Large D-Flow FM outputs
s01_integration_work/**/*.nc
s01_integration_work/**/*.cache
s01_integration_work/**/*.dia
s01_integration_work/**/*.his
s01_integration_work/**/*.map
s01_integration_work/**/*.rst

# Large GIS/SAR generated data
s01_integration_work/member3_gis/gis/data/
s01_integration_work/member3_gis/gis/output/*.tif
s01_integration_work/member3_gis/gis/output/*.img

# Generated images/previews
s01_integration_work/**/*.png

# Temporary / backup artifacts
src/*.before_*
src/*_backup_*
src/*_before_*
